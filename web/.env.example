# BuyBox Matcher frontend environment.
#
# Requirement 14.2: VITE_API_URL is the ONLY external reference the frontend
# is permitted to hold. Do NOT add AI provider keys (OPENAI_API_KEY,
# ANTHROPIC_API_KEY) or database credentials (SUPABASE_KEY) here — those live
# exclusively in the backend environment.

# Base URL of the BuyBox Matcher backend API.
VITE_API_URL=http://localhost:8000
