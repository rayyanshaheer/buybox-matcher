# BuyBox Matcher backend environment.
#
# Copy this file to `.env` and fill in real values locally. NEVER commit a
# populated `.env`. All AI provider keys and database credentials live here on
# the backend ONLY — the frontend's sole external reference is VITE_API_URL
# (Requirements 14.2, 14.3). Values below are placeholders, not real secrets.

# --- AI provider (Req 14.3) ------------------------------------------------
# Which AI provider the backend calls for extraction / drafting.
# One of: openai | anthropic
AI_PROVIDER=openai

# Provide the API key that matches the AI_PROVIDER selected above. Only the
# selected provider's key is required at startup; the other may be left blank.
# OpenAI key (required when AI_PROVIDER=openai).
OPENAI_API_KEY=sk-your-openai-api-key-here
# Anthropic key (required when AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --- Database / Supabase (Req 14.3) ----------------------------------------
# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase service/anon key used by the backend Supabase client.
SUPABASE_KEY=your-supabase-key-here

# --- CORS (Req 10.9, 10.10) ------------------------------------------------
# The single allowed browser origin for the Web_App (no trailing slash).
ALLOWED_ORIGIN=http://localhost:5173
